PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin credentials.
# Preferred for local/server deployment:
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json

# Alternative: put the complete service-account JSON on one line.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Existing Realtime Database URL
FIREBASE_DATABASE_URL=https://ppfgwh-713a2-default-rtdb.asia-southeast1.firebasedatabase.app

# Optional Google Apps Script proxy
GAS_API_URL=
